{
  "name": "pocket-mastodon-callback",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIRINGS",
        "class_name": "Pairing"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Pairing"
      ]
    }
  ]
}
